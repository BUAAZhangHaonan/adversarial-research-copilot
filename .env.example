# GPT endpoint (OpenAI Responses API style)
GPT_BASE_URL=https://gmn.chuangzuoli.com/v1
GPT_API_KEY=replace_with_your_gpt_key
GPT_MODEL=gpt-5.4

# GLM endpoint (official: https://open.bigmodel.cn/api/paas/v4/chat/completions)
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=replace_with_your_glm_key
GLM_MODEL=glm-5

# Optional defaults
ARC_DEFAULT_PROPOSER=gpt-5.4
ARC_DEFAULT_SKEPTIC=glm-5
ARC_DEFAULT_MODERATOR=gpt-5.4
ARC_DEFAULT_PIPELINE_WRITER=gpt-5.4
ARC_DEFAULT_PIPELINE_REVIEWER=glm-5
ARC_DEFAULT_PIPELINE_MODERATOR=gpt-5.4

# GPT reasoning controls (Responses API)
ARC_GPT_REASONING_EFFORT=high
ARC_GPT_VERBOSITY=medium

# Generation controls (override config defaults when needed)
# Keep large by default for long-form pipeline artifacts.
ARC_MAX_OUTPUT_TOKENS=16384
ARC_CHAT_MAX_TOKENS=16384
ARC_FALLBACK_MAX_OUTPUT_TOKENS=4096
# Optional global temperature override (empty = use model/config value)
# ARC_TEMPERATURE=0.3

# Optional network robustness
ARC_LLM_TIMEOUT_SECONDS=180
ARC_LLM_RETRY_ATTEMPTS=4

# Literature sources
SEMANTIC_SCHOLAR_API_KEY=replace_with_your_semantic_scholar_key
# Optional external source: GLM Coding Plan MCP
# ARC_GLM_CODING_PLAN_MCP_URL=https://your-mcp-endpoint/search
# ARC_GLM_CODING_PLAN_MCP_API_KEY=replace_with_your_mcp_key
