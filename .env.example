# GPT endpoint (OpenAI Responses API style)
GPT_BASE_URL=https://gmn.chuangzuoli.com/v1
GPT_API_KEY=replace_with_your_gpt_key
GPT_MODEL=gpt-5.4

# GLM endpoint (official: https://open.bigmodel.cn/api/coding/paas/v4/chat/completions)
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/chat/completions
GLM_API_KEY=replace_with_your_glm_key
GLM_MODEL=glm-5.1

# DeepSeek endpoint (official OpenAI-compatible API; models: deepseek-v4-flash, deepseek-v4-pro)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# Optional defaults (deepseek split: flash generates, pro adjudicates)
ARC_DEFAULT_PROPOSER=deepseek-v4-flash
ARC_DEFAULT_SKEPTIC=deepseek-v4-flash
ARC_DEFAULT_MODERATOR=deepseek-v4-pro
ARC_DEFAULT_PIPELINE_WRITER=deepseek-v4-flash
ARC_DEFAULT_PIPELINE_REVIEWER=deepseek-v4-pro
ARC_DEFAULT_PIPELINE_MODERATOR=deepseek-v4-pro

# GPT reasoning controls (Responses API)
ARC_GPT_REASONING_EFFORT=high
ARC_GPT_VERBOSITY=medium

# Generation controls (override config defaults when needed)
# Keep large by default for long-form pipeline artifacts.
ARC_MAX_OUTPUT_TOKENS=16384
ARC_CHAT_MAX_TOKENS=16384
ARC_FALLBACK_MAX_OUTPUT_TOKENS=4096
# Optional global temperature override (empty = use model/config value)
# ARC_TEMPERATURE=0.3

# Optional network robustness
ARC_LLM_TIMEOUT_SECONDS=180
ARC_LLM_RETRY_ATTEMPTS=4

# Literature sources
SEMANTIC_SCHOLAR_API_KEY=replace_with_your_semantic_scholar_key
# Optional: DeepXiv token (official flow can auto-register on first use)
# DEEPXIV_TOKEN=replace_with_your_deepxiv_token

# Optional runtime overrides for unified retrieval
# ARC_DEEPXIV_ENABLED=true
# ARC_REFERENCE_SEARCH_POOL_SIZE=50
# ARC_REFERENCE_FINAL_COUNT=20

# MCP services for discover mode (all three are mandatory; discover fails fast if any is down)
# webresearch-mcp (stdio): command line that launches the server
# ARC_MCP_WEBRESEARCH_CMD="/path/to/webresearch-mcp/.venv/bin/python -m webresearch_mcp.server"
ARC_MCP_WEBRESEARCH_CMD=replace_with_webresearch_launch_command
# scholartrace / scholaranalysis (SSE): use loopback when the services run on this host
ARC_SCHOLARTRACE_URL=http://127.0.0.1:8001/sse
ARC_SCHOLARTRACE_TOKEN=replace_with_scholartrace_token
ARC_SCHOLARANALYSIS_URL=http://127.0.0.1:8005/sse
ARC_SCHOLARANALYSIS_TOKEN=replace_with_scholaranalysis_token
# Per-MCP-call timeout in seconds (scholartrace.query can take minutes)
# ARC_MCP_CALL_TIMEOUT_SECONDS=900
